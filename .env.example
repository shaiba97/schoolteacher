# Teacher portal environment
# The backend API the portal proxies to (server-side).
TEACHER_API_URL=http://localhost:3000/api

# Tenant id resolved at login and stored with the session cookie.
# Required for employee-ID sign in (IDs are unique per school, so the tenant
# must be known before the first attempt — there is no school picker for IDs).
NEXT_PUBLIC_TENANT_ID=

# Dev bypass (mirrors backend AUTH_NO_SESSION): skip the portal guard.
# Never enable in production.
# TEACHER_NO_AUTH=true
